# Apptainer definition for the compact 3D Gaussian splatting benchmark.
#
# Build:  apptainer build container.sif container.def
#
# CUDA *devel* base: the official 3DGS / SteepGS rasterizer and simple-knn are
# CUDA extensions compiled by environment/setup.sh (nvcc required).
# The agent's workspace is bind-mounted at /home/user at runtime; it is NOT
# baked into the container. Python packages are installed by setup.sh.

Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python-is-python3 \
        build-essential ninja-build git curl wget ca-certificates unzip \
        libgl1 libglib2.0-0 libgomp1 \
        tmux nano vim-tiny less && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/*

    # *** DO NOT put pip install here. Use setup.sh instead. ***

    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0"
